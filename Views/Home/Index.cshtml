
@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="hero-section">
        <h1>Library Management System</h1>
        <p class="lead">
            A simple web-based system for managing books, members, librarians, and borrowing activities.
        </p>
        <a href="/Account/Register" class="btn btn-primary">Get Started</a>
    </section>

    <div class="row feature-section">
        <section class="col-md-4">
            <h2>Book Management</h2>
            <p>Add, update, search, and manage library book records efficiently.</p>
        </section>

        <section class="col-md-4">
            <h2>Member Access</h2>
            <p>Members can register, log in, and access library-related services.</p>
        </section>

        <section class="col-md-4">
            <h2>Librarian Dashboard</h2>
            <p>Librarians can manage library operations through a role-based dashboard.</p>
        </section>
    </div>
</main>