@model LibrarySystem99.Models.BorrowingPolicy

@{
    ViewBag.Title = "Edit Borrowing Policy";
}

<div class="container">
    <h2>Edit Borrowing Policy</h2>

    @using (Html.BeginForm("Edit", "BorrowingPolicies", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.MaxBooksPerUser, new { @class = "control-label col-md-3" })
            <div class="col-md-6">
                @Html.EditorFor(m => m.MaxBooksPerUser, new { htmlAttributes = new { @class = "form-control", min = 1 } })
                @Html.ValidationMessageFor(m => m.MaxBooksPerUser, "", new { @class = "text-danger" })
                <small class="help-block">How many books a member can have borrowed at once.</small>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.BorrowDays, new { @class = "control-label col-md-3" })
            <div class="col-md-6">
                @Html.EditorFor(m => m.BorrowDays, new { htmlAttributes = new { @class = "form-control", min = 1 } })
                @Html.ValidationMessageFor(m => m.BorrowDays, "", new { @class = "text-danger" })
                <small class="help-block">Default loan period (in days).</small>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MaxRenewals, new { @class = "control-label col-md-3" })
            <div class="col-md-6">
                @Html.EditorFor(m => m.MaxRenewals, new { htmlAttributes = new { @class = "form-control", min = 0 } })
                @Html.ValidationMessageFor(m => m.MaxRenewals, "", new { @class = "text-danger" })
                <small class="help-block">Max times a borrow can be renewed.</small>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.FinePerDay, new { @class = "control-label col-md-3" })
            <div class="col-md-6">
                @Html.EditorFor(m => m.FinePerDay, new { htmlAttributes = new { @class = "form-control", min = 0, step = "0.01" } })
                @Html.ValidationMessageFor(m => m.FinePerDay, "", new { @class = "text-danger" })
                <small class="help-block">Dollar amount charged per day overdue.</small>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-3 col-md-6">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
            </div>
        </div>
    }
</div>