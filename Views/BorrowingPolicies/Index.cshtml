@model LibrarySystem99.Models.BorrowingPolicy

@{
    ViewBag.Title = "Borrowing Policy";
}

<div class="container">
    <h2>Library Borrowing Policy</h2>
    <p class="text-muted">These rules apply to all members.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model == null)
    {
        <p class="text-warning">No policy configured.</p>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                <div class="policy-box">
                    <div class="panel-heading"><h4>Max Books Per User</h4></div>
                    <div class="text-center">
                        <h1 style="margin:0;">@Model.MaxBooksPerUser</h1>
                        <p class="text-muted">simultaneous borrows allowed</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="policy-box">
                    <div class="panel-heading"><h4>Loan Period</h4></div>
                    <div class="panel-body text-center">
                        <h1 style="margin:0;">@Model.BorrowDays</h1>
                        <p class="text-muted">days per borrow</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="policy-box">
                    <div class="panel-heading"><h4>Max Renewals</h4></div>
                    <div class="panel-body text-center">
                        <h1 style="margin:0;">@Model.MaxRenewals</h1>
                        <p class="text-muted">renewals per borrow</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="policy-box">
                    <div>
                    <h4>Late Fine</h4></div>
                    <div class="panel-body text-center">
                        <h1 class="policy-value">$@Model.FinePerDay</h1>
                        <p class="policy-text">per day overdue</p>
                    </div>
                </div>
            </div>
        </div>

        <p>
            @Html.ActionLink("Edit Policy", "Edit", null, new { @class = "btn btn-warning" })
            @Html.ActionLink("« Back to Dashboard", "Index", "Librarian", null, new { @class = "btn btn-default" })
        </p>
    }
</div>