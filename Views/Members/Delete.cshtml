@model LibrarySystem99.Models.ApplicationUser

@{
    ViewBag.Title = "Delete Member";
}

<div class="container">
    <h2>Delete Member</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (ViewBag.HasActiveBorrowings == true)
    {
        <div class="alert alert-warning">
            <strong>Warning:</strong> This member has active borrowings.
            They must return all books before their account can be deleted.
        </div>
    }
    else
    {
        <h3>Are you sure you want to delete this member?</h3>
        <p class="text-danger">This action cannot be undone.</p>
    }

    <div class="panel panel-default">
        <div class="panel-heading"><h4>Member</h4></div>
        <div class="panel-body">
            <dl class="dl-horizontal">
                <dt>Email:</dt>
                <dd>@Model.Email</dd>

                <dt>Username:</dt>
                <dd>@Model.UserName</dd>

                <dt>Phone:</dt>
                <dd>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd>
            </dl>
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            @if (ViewBag.HasActiveBorrowings == false)
            {
                <input type="submit" value="Delete" class="btn btn-danger" />
            }
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>