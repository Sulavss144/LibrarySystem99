@model IEnumerable<LibrarySystem99.Models.ApplicationUser>

@{
    ViewBag.Title = "Member Management";
}

<div class="container">
    <h2>Member Management</h2>
    <p class="text-muted">View and manage all library members.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Phone</th>
                    <th>Email Confirmed</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr>
                        <td>@member.Email</td>
                        <td>@member.UserName</td>
                        <td>@(string.IsNullOrEmpty(member.PhoneNumber) ? "—" : member.PhoneNumber)</td>
                        <td>
                            @if (member.EmailConfirmed)
                            {
                                <span class="label label-success">Yes</span>
                            }
                            else
                            {
                                <span class="label label-default">No</span>
                            }
                        </td>
                        <td>
                            @Html.ActionLink("Details", "Details", new { id = member.Id }, new { @class = "btn btn-info btn-sm" })
                            @Html.ActionLink("Edit", "Edit", new { id = member.Id }, new { @class = "btn btn-warning btn-sm" })
                            @Html.ActionLink("Delete", "Delete", new { id = member.Id }, new { @class = "btn btn-danger btn-sm" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="text-muted"><strong>Total members:</strong> @Model.Count()</p>
    }
    else
    {
        <p class="text-muted">No members registered yet.</p>
    }

    <p>
        @Html.ActionLink("« Back to Dashboard", "Index", "Librarian", null, new { @class = "btn btn-default" })
    </p>
</div>