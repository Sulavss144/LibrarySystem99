@model IEnumerable<LibrarySystem99.Models.BorrowingTransaction>

@{
    ViewBag.Title = "My Borrowed Books";
}

<div class="container">
    <h2>My Borrowed Books</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.Book != null)
                            {
                                @Html.ActionLink(item.Book.Title, "Details", "Books", new { id = item.BookId }, null)
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </td>
                        <td>@item.BorrowDate.ToShortDateString()</td>
                        <td>@item.DueDate.ToShortDateString()</td>
                        <td>
                            @if (item.IsReturned)
                            {
                                <span class="label label-success">Returned</span>
                            }
                            else if (item.DueDate < DateTime.Now)
                            {
                                <span class="label label-danger">Overdue</span>
                            }
                            else
                            {
                                <span class="label label-info">Active</span>
                            }
                        </td>
                        <td>
                            @if (!item.IsReturned)
                            {
                                @Html.ActionLink("Return", "Return", "Books", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" })
                            }

                            @Html.ActionLink("Review", "Create", "BookReviews", new { bookId = item.BookId }, new { @class = "btn btn-info btn-sm" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">You haven't borrowed any books yet. <a href="@Url.Action("Index", "Books")">Browse the catalogue</a> to get started.</p>
    }

    <hr />
    <p>
        @Html.ActionLink("« Back to Dashboard", "Index", "Member", null, new { @class = "btn btn-default" })
    </p>
</div>