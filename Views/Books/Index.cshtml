@model IEnumerable<LibrarySystem99.Models.Book>

@{
    ViewBag.Title = "Books";
}

<h2>Books</h2>
@using (Html.BeginForm("Index", "Books", FormMethod.Get, new { @class = "form-inline", style = "margin-bottom: 20px;" }))
{
    <div class="form-group">
        <input type="text" name="searchQuery" value="@ViewBag.SearchQuery" class="form-control" placeholder="Search by title or author..." style="width: 300px;" />
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
    if (!string.IsNullOrWhiteSpace(ViewBag.SearchQuery as string))
    {
        @Html.ActionLink("Clear", "Index", null, new { @class = "btn btn-default" })
        <span class="text-muted" style="margin-left:10px;">
            Showing results for <strong>"@ViewBag.SearchQuery"</strong>
        </span>
    }
}


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    @if (User.IsInRole("Librarian"))
    {
        @Html.ActionLink("Create New", "Create", null,
            new { @class = "btn btn-primary" })
    }
</p>

<table class="table table-bordered">
    <tr>
        <th>@Html.DisplayNameFor(model => model.Title)</th>
        <th>@Html.DisplayNameFor(model => model.Author)</th>
        <th>@Html.DisplayNameFor(model => model.ISBN)</th>
        <th>@Html.DisplayNameFor(model => model.Category)</th>
        <th>@Html.DisplayNameFor(model => model.TotalCopies)</th>
        <th>@Html.DisplayNameFor(model => model.AvailableCopies)</th>
        <th>@Html.DisplayNameFor(model => model.Description)</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Title)</td>
            <td>@Html.DisplayFor(modelItem => item.Author)</td>
            <td>@Html.DisplayFor(modelItem => item.ISBN)</td>
            <td>@Html.DisplayFor(modelItem => item.Category)</td>
            <td>@Html.DisplayFor(modelItem => item.TotalCopies)</td>
            <td>
                @if (item.AvailableCopies > 0)
                {
                    <span class="label label-success">@item.AvailableCopies</span>
                }
                else
                {
                    <span class="label label-danger">0</span>
                }
            </td>
            <td>@Html.DisplayFor(modelItem => item.Description)</td>
            <td>
                @Html.ActionLink("Details", "Details",
                    new { id = item.Id },
                    new { @class = "btn btn-info btn-sm" })

                @* Librarian actions *@
                @if (User.IsInRole("Librarian"))
                {
                    @Html.Raw(" ")
                    @Html.ActionLink("Edit", "Edit",
                        new { id = item.Id },
                        new { @class = "btn btn-warning btn-sm" })

                    @Html.Raw(" ")
                    @Html.ActionLink("Delete", "Delete",
                        new { id = item.Id },
                        new { @class = "btn btn-danger btn-sm" })
                }

                @* Member actions *@
                @if (User.IsInRole("Member"))
                {
                    @Html.Raw(" ")

                    if (item.AvailableCopies > 0)
                    {
                        @Html.ActionLink("Borrow", "Borrow", "Books",
                            new { id = item.Id },
                            new { @class = "btn btn-success btn-sm" })
                    }
                    else
                    {
                        using (Html.BeginForm("Create", "Reservations", FormMethod.Post, new { style = "display:inline;" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookId" value="@item.Id" />
                            <button type="submit" class="btn btn-warning btn-sm" title="Reserve this book — you'll be added to the queue">
                                Reserve
                            </button>
                        }
                    }
                }
            </td>
        </tr>
    }
</table>