@model IEnumerable<LibrarySystem99.Models.Book>

@{
    ViewBag.Title = "Books";
}

<div class="page-header-box">
    <h2>Library Books</h2>
    <p>Manage book records, availability, and catalogue information.</p>
</div>

<div class="search-box">
    @using (Html.BeginForm("Index", "Books", FormMethod.Get, new { @class = "form-inline" }))
    {
        <div class="form-group">
            <input type="text"
                   name="searchQuery"
                   value="@ViewBag.SearchQuery"
                   class="form-control"
                   placeholder="Search by title or author..." />
        </div>

        <button type="submit" class="btn btn-primary">Search</button>

        if (!string.IsNullOrWhiteSpace(ViewBag.SearchQuery as string))
        {
            @Html.ActionLink("Clear", "Index", null, new { @class = "btn btn-default" })

            <span class="text-muted search-result-text">
                Showing results for <strong>"@ViewBag.SearchQuery"</strong>
            </span>
        }
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (User.IsInRole("Librarian"))
{
    <p>
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
    </p>
}

<table class="table books-table">
    <tr>
        <th>@Html.DisplayNameFor(model => model.Title)</th>
        <th>@Html.DisplayNameFor(model => model.Author)</th>
        <th>@Html.DisplayNameFor(model => model.ISBN)</th>
        <th>@Html.DisplayNameFor(model => model.Category)</th>
        <th>@Html.DisplayNameFor(model => model.TotalCopies)</th>
        <th>@Html.DisplayNameFor(model => model.AvailableCopies)</th>
        <th>@Html.DisplayNameFor(model => model.Description)</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Title)</td>
            <td>@Html.DisplayFor(modelItem => item.Author)</td>
            <td>@Html.DisplayFor(modelItem => item.ISBN)</td>
            <td>@Html.DisplayFor(modelItem => item.Category)</td>
            <td>@Html.DisplayFor(modelItem => item.TotalCopies)</td>

            <td>
                @if (item.AvailableCopies > 0)
                {
                    <span class="availability available">@item.AvailableCopies</span>
                }
                else
                {
                    <span class="availability unavailable">0</span>
                }
            </td>

            <td>@Html.DisplayFor(modelItem => item.Description)</td>

            <td class="action-links">
                @Html.ActionLink("Details", "Details",
                    new { id = item.Id },
                    new { @class = "btn btn-info btn-sm" })

                @if (User.IsInRole("Librarian"))
                {
                    @Html.ActionLink("Edit", "Edit",
                        new { id = item.Id },
                        new { @class = "btn btn-warning btn-sm" })

                    @Html.ActionLink("Delete", "Delete",
                        new { id = item.Id },
                        new { @class = "btn btn-danger btn-sm" })
                }

                @if (User.IsInRole("Member"))
                {
                    if (item.AvailableCopies > 0)
                    {
                        @Html.ActionLink("Borrow", "Borrow", "Books",
                            new { id = item.Id },
                            new { @class = "btn btn-success btn-sm" })
                    }
                    else
                    {
                        using (Html.BeginForm("Create", "Reservations", FormMethod.Post, new { @class = "inline-form" }))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="bookId" value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-warning btn-sm"
                                    title="Reserve this book — you'll be added to the queue">
                                Reserve
                            </button>
                        }
                    }
                }
            </td>
        </tr>
    }
</table>