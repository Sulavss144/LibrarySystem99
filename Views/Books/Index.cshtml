@model IEnumerable<LibrarySystem99.Models.Book>

@{
    ViewBag.Title = "Books";
}

<div class="page-header-box">
    <h2>Library Books</h2>
    <p>Browse and manage the library collection</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@* ===== SEARCH BAR ===== *@
<div class="search-box">
    @using (Html.BeginForm("Index", "Books", FormMethod.Get, new { @class = "form-inline" }))
    {
        <div class="form-group">
            <input type="text"
                   name="searchQuery"
                   value="@ViewBag.SearchQuery"
                   class="form-control"
                   placeholder="Search by title or author..." />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>

        if (!string.IsNullOrWhiteSpace(ViewBag.SearchQuery as string))
        {
            @Html.ActionLink("Clear", "Index", null, new { @class = "btn btn-default" })
            <span class="text-muted search-result-text">
                Showing results for <strong>"@ViewBag.SearchQuery"</strong>
            </span>
        }
    }
</div>

@if (User.IsInRole("Librarian"))
{
    <p>
        @Html.ActionLink("Create New Book", "Create", null, new { @class = "btn btn-primary" })
    </p>
}

@* ===== CARD GRID ===== *@
<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-3 col-sm-6">
            <div class="book-card">

                @* ===== COVER IMAGE ===== *@
                <img src="@(string.IsNullOrEmpty(item.CoverImageUrl)
                        ? "https://via.placeholder.com/200x280/eeeeee/999999?text=No+Cover"
                        : item.CoverImageUrl)"
                     class="book-cover"
                     alt="@item.Title cover" />

                @* ===== DETAILS ===== *@
                <h4>@item.Title</h4>
                <p>@item.Author</p>
                <p>@item.Category</p>

                <p>
                    <span class="availability @(item.AvailableCopies > 0 ? "available" : "unavailable")">
                        @item.AvailableCopies Available
                    </span>
                </p>

                @* ===== ACTIONS ===== *@
                <div class="action-links">

                    @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm" })

                    @if (User.IsInRole("Librarian"))
                    {
                        @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger btn-sm" })
                    }

                    @if (User.IsInRole("Member"))
                    {
                        if (item.AvailableCopies > 0)
                        {
                            @Html.ActionLink("Borrow", "Borrow", "Books", new { id = item.Id }, new { @class = "btn btn-success btn-sm" })
                        }
                        else
                        {
                            using (Html.BeginForm("Create", "Reservations", FormMethod.Post, new { @class = "inline-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookId" value="@item.Id" />
                                <button type="submit"
                                        class="btn btn-warning btn-sm"
                                        title="Reserve this book — you'll be added to the queue">
                                    Reserve
                                </button>
                            }
                        }
                    }

                </div>

            </div>
        </div>
    }

</div>