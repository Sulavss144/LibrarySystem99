
@model IEnumerable<LibrarySystem99.Models.Book>

@{
    ViewBag.Title = "Books";
}

<h2>Books</h2>

<p>
    @if (User.IsInRole("Librarian"))
    {
        @Html.ActionLink("Create New", "Create", null,
            new { @class = "btn btn-primary" })
    }
</p>

<table class="table table-bordered">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Author)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ISBN)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Category)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TotalCopies)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AvailableCopies)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            Actions
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Author)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.ISBN)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.TotalCopies)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.AvailableCopies)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>

            <td>

                @Html.ActionLink("Details", "Details",
                    new { id = item.Id },
                    new { @class = "btn btn-info btn-sm" })

                <!-- Librarian Only -->
                @if (User.IsInRole("Librarian"))
                {
                    @Html.Raw(" ")

                    @Html.ActionLink("Edit", "Edit",
                        new { id = item.Id },
                        new { @class = "btn btn-warning btn-sm" })

                    @Html.Raw(" ")

                    @Html.ActionLink("Delete", "Delete",
                        new { id = item.Id },
                        new { @class = "btn btn-danger btn-sm" })
                }

                <!-- Member Only -->
                @if (User.IsInRole("Member"))
                {
                    @Html.Raw(" ")

                    if (item.AvailableCopies > 0)
                    {
                        @Html.ActionLink("Borrow", "Borrow",
                            new { id = item.Id },
                            new { @class = "btn btn-success btn-sm" })
                    }
                    else
                    {
                        <span class="text-danger">
                            Not Available
                        </span>
                    }
                }

            </td>
        </tr>
    }

</table>
```
