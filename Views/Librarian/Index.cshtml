@{
    ViewBag.Title = "Librarian Dashboard";
}

<main class="dashboard-page">

    <div class="dashboard-header">
        <h1>Librarian Dashboard</h1>
        <p>Welcome, @User.Identity.Name. You have full access to manage library operations.</p>
    </div>

    <div class="dashboard-grid">

        <div class="dashboard-card">
            <h3>Books Management</h3>
            <p>Add new books, update existing records, and manage book availability.</p>
            <a href="/Books" class="btn auth-btn">Manage Books</a>
        </div>

        <div class="dashboard-card">
            <h3>Member Management</h3>
            <p>View registered members, manage accounts, and monitor borrowing activity.</p>
            <a href="/Member" class="btn auth-btn">View Members</a>
        </div>

        <div class="dashboard-card">
            <h3>Reports</h3>
            <p>Check borrowing reports, overdue books, and library usage information.</p>
            <a href="#" class="btn auth-btn">View Reports</a>
        </div>

    </div>

    <div class="dashboard-note">
        <strong>Security note:</strong>
        This page is protected and only accessible to users with the Librarian role.
    </div>

</main>