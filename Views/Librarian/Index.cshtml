@model IEnumerable<LibrarySystem99.Models.BorrowingTransaction>

@{
    ViewBag.Title = "Librarian Dashboard";
}

<div class="dashboard-page">

    @* ===== WELCOME HEADER ===== *@
    <div class="dashboard-header">
        <h1>Librarian Dashboard</h1>
        <p>Welcome, @User.Identity.Name. You have full library management access.</p>
    </div>

    @* ===== KPI STATS ===== *@
    <div class="dashboard-stats">
        <div class="dashboard-stat-box">
            <h3>Total Books</h3>
            <strong>@ViewBag.TotalBooks</strong>
        </div>

        <div class="dashboard-stat-box">
            <h3>Active Borrows</h3>
            <strong>@ViewBag.ActiveBorrows</strong>
        </div>

        <div class="dashboard-stat-box">
            <h3>Overdue Books</h3>
            <strong style="color:#c0392b;">@ViewBag.OverdueBooks</strong>
        </div>
    </div>

    @* ===== QUICK ACTION CARDS ===== *@
    <h3>Quick Actions</h3>
    <div class="dashboard-grid">
        <div class="dashboard-card">
            <h3>Books Management</h3>
            <p>Add new books to the catalogue, edit existing entries, and remove outdated titles.</p>
            <p>@Html.ActionLink("Manage Books »", "Index", "Books", null, new { @class = "btn" })</p>
        </div>

        <div class="dashboard-card">
            <h3>Member Management</h3>
            <p>View all registered members, manage accounts, and monitor borrowing activity.</p>
            <p>@Html.ActionLink("View Members »", "Index", "Members", null, new { @class = "btn" })</p>
        </div>

        <div class="dashboard-card">
            <h3>Reports</h3>
            <p>View borrowing statistics, overdue books, and library usage reports.</p>
            <p>@Html.ActionLink("View Reports »", "Index", "Reports", null, new { @class = "btn" })</p>
        </div>
    </div>

    <hr />

    @* ===== DASHBOARD WIDGETS (New Arrivals / Most Borrowed / Available) ===== *@
    @Html.Partial("_DashboardWidgets")

    <hr />

    @* ===== RECENT BORROW ACTIVITY ===== *@
    <h3>Recent Borrow Activity</h3>

    @if (Model != null && Model.Any())
    {
        <table class="recent-table">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>User</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.Book != null ? item.Book.Title : "—")</td>
                        <td>@(item.User != null ? item.User.Email : "—")</td>
                        <td>@item.BorrowDate.ToShortDateString()</td>
                        <td>@item.DueDate.ToShortDateString()</td>
                        <td>
                            @if (item.IsReturned)
                            {
                                <span class="status-badge returned">Returned</span>
                            }
                            else if (item.DueDate < DateTime.Now)
                            {
                                <span class="status-badge overdue">Overdue</span>
                            }
                            else
                            {
                                <span class="status-badge active">Active</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No borrow activity yet.</p>
    }

    <hr />
    <p class="text-muted small">
        <strong>Admin tools:</strong>
        @Html.ActionLink("Reset library data", "ResetData", "Librarian") (for clearing test data before a demo)
    </p>

</div>