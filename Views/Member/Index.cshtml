@model IEnumerable<LibrarySystem99.Models.BorrowingTransaction>

@{
    ViewBag.Title = "Member Dashboard";
}

<div class="dashboard-page">

    @* ===== WELCOME HEADER ===== *@
    <div class="dashboard-header">
        <h1>Member Dashboard</h1>
        <p>Welcome back, @User.Identity.Name. Ready to find your next read?</p>
    </div>

    @* ===== KPI STATS ===== *@
    <div class="dashboard-stats">
        <div class="dashboard-stat-box">
            <h3>Total Borrowed</h3>
            <strong>@ViewBag.TotalBorrowed</strong>
        </div>

        <div class="dashboard-stat-box">
            <h3>Currently Borrowed</h3>
            <strong>@ViewBag.CurrentlyBorrowed</strong>
        </div>

        <div class="dashboard-stat-box">
            <h3>Overdue</h3>
            <strong style="color:#c0392b;">@ViewBag.OverdueCount</strong>
        </div>
    </div>

    @* ===== QUICK ACTION CARDS ===== *@
    <h3>Quick Actions</h3>
    <div class="dashboard-grid">
        <div class="dashboard-card">
            <h3>Browse Books</h3>
            <p>Explore the library catalogue, search by title or author, and find your next book.</p>
            <p>@Html.ActionLink("Browse Catalogue »", "Index", "Books", null, new { @class = "btn" })</p>
        </div>

        <div class="dashboard-card">
            <h3>My Borrowings</h3>
            <p>View books you've currently borrowed, check due dates, and return books online.</p>
            <p>@Html.ActionLink("My Borrowings »", "MyBooks", "Books", null, new { @class = "btn" })</p>
        </div>

        <div class="dashboard-card">
            <h3>My Profile</h3>
            <p>Update your personal details, change your password, and manage your account.</p>
            <p>@Html.ActionLink("View Profile »", "Index", "Manage", null, new { @class = "btn" })</p>
        </div>
    </div>

    <hr />

    @* ===== DASHBOARD WIDGETS (New Arrivals / Most Borrowed / Available) ===== *@
    @Html.Partial("_DashboardWidgets")

    <hr />

    @* ===== MY BORROWED BOOKS ===== *@
    <h3 id="my-borrowings">My Borrowed Books</h3>

    @if (Model != null && Model.Any())
    {
        <table class="recent-table">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.Book != null ? item.Book.Title : "—")</td>
                        <td>@item.BorrowDate.ToShortDateString()</td>
                        <td>@item.DueDate.ToShortDateString()</td>
                        <td>
                            @if (item.IsReturned)
                            {
                                <span class="status-badge returned">Returned</span>
                            }
                            else if (item.DueDate < DateTime.Now)
                            {
                                <span class="status-badge overdue">Overdue</span>
                            }
                            else
                            {
                                <span class="status-badge active">Active</span>
                            }
                        </td>
                        <td>
                            @if (!item.IsReturned)
                            {
                                @Html.ActionLink("Return", "Return", "Books", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" })
                            }

                            @Html.ActionLink("Review", "Create", "BookReviews", new { bookId = item.BookId }, new { @class = "btn btn-info btn-sm" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">You haven't borrowed any books yet. <a href="@Url.Action("Index", "Books")">Browse the catalogue</a> to get started.</p>
    }

</div>