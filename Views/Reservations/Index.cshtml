@model IEnumerable<LibrarySystem99.Models.Reservation>

@{
    ViewBag.Title = "Reservations";
    bool isLibrarian = User.IsInRole("Librarian") || User.IsInRole("Admin");
}

<div class="container">
    <h2>@(isLibrarian ? "All Reservations" : "My Reservations")</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Book</th>
                    @if (isLibrarian)
                    {
                        <th>Member</th>
                    }
                    <th>Reserved On</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@(r.Book != null ? r.Book.Title : "—")</td>
                        @if (isLibrarian)
                        {
                            <td>@(r.User != null ? r.User.Email : "—")</td>
                        }
                        <td>@r.ReservationDate.ToShortDateString()</td>
                        <td>
                            @if (r.Status == LibrarySystem99.Models.ReservationStatus.Waiting)
                            {
                                <span class="label label-info">Waiting</span>
                            }
                            else if (r.Status == LibrarySystem99.Models.ReservationStatus.Ready)
                            {
                                <span class="label label-success">Ready for Pickup</span>
                            }
                            else if (r.Status == LibrarySystem99.Models.ReservationStatus.Fulfilled)
                            {
                                <span class="label label-default">Fulfilled</span>
                            }
                            else if (r.Status == LibrarySystem99.Models.ReservationStatus.Cancelled)
                            {
                                <span class="label label-default">Cancelled</span>
                            }
                        </td>
                        <td>
                            @if (r.Status == LibrarySystem99.Models.ReservationStatus.Ready)
                            {
                                <form action="@Url.Action("Fulfill", "Reservations", new { id = r.Id })" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">Pick Up / Borrow</button>
                                </form>
                            }

                            @if (r.Status == LibrarySystem99.Models.ReservationStatus.Waiting || r.Status == LibrarySystem99.Models.ReservationStatus.Ready)
                            {
                                <form action="@Url.Action("Cancel", "Reservations", new { id = r.Id })" method="post" style="display:inline; margin-left:4px;" onsubmit="return confirm('Cancel this reservation?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                                </form>
                            }

                            @if (r.Status == LibrarySystem99.Models.ReservationStatus.Fulfilled || r.Status == LibrarySystem99.Models.ReservationStatus.Cancelled)
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No reservations yet.</p>
    }

    <hr />
    <p>
        @if (isLibrarian)
        {
            @Html.ActionLink("« Back to Dashboard", "Index", "Librarian", null, new { @class = "btn btn-default" })
        }
        else
        {
            @Html.ActionLink("« Back to Dashboard", "Index", "Member", null, new { @class = "btn btn-default" })
        }
    </p>
</div>